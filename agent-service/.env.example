# 复制为 .env 后填写；.env 已被 git 忽略，不要提交真实密钥

# 应用配置
APP_NAME=安心保
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8001

# 日志配置：DEBUG、INFO、WARNING、ERROR、CRITICAL
LOGGING_LEVEL=INFO

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insurance
DB_USER=insurance
DB_PASSWORD=

# 认证配置：密钥至少32个字符，可用 `openssl rand -hex 32` 生成
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 模型配置
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash

# MinerU（仅入库脚本解析 PDF 时使用）
MINERU_TOKEN=

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# 向量模型（Ollama）
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
