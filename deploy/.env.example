# 复制为 deploy/.env 后填写；.env 已被 git 忽略
# 密码和密钥都不要使用示例值，可用 `openssl rand -hex 32` 生成

# ---- 基础设施（必填）----
POSTGRES_DB=insurance
POSTGRES_USER=insurance
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# 基础设施端口的绑定地址：生产保持 127.0.0.1；开发机需要远程连接时设为虚拟机的局域网 IP
BIND_ADDR=127.0.0.1
POSTGRES_PORT=5432
MILVUS_PORT=19530
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OLLAMA_PORT=11434

# ---- 应用（使用 --profile app 部署时必填）----
WEB_PORT=80
AUTH_JWT_SECRET=
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash
MINERU_TOKEN=
EMBEDDING_MODEL=qwen3-embedding:0.6b
# 留空时使用 compose 内的 ollama 服务（需 --profile ollama）；使用外部 Ollama 时填写其地址
OLLAMA_BASE_URL=
